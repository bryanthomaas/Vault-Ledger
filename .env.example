# Environment configuration for Vault Ledger

# Database
DATABASE_URL=postgres://vault:vault@localhost:5433/vault_ledger

# Auth
JWT_SECRET=dev-secret-must-be-at-least-32-chars-long-for-hs256!
REFRESH_TOKEN_SECRET=dev-refresh-secret-must-be-at-least-32-chars!

# API
PORT=4000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,http://127.0.0.1:8081

# Worker & Automation
RUN_WORKER=true

# Optional Plaid Sandbox (leave blank for default deterministic synthetic provider)
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
